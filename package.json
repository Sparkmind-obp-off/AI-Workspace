{
  "name": "ai-workspace",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build && esbuild workers/api/src/index.ts --bundle --format=esm --platform=browser --outfile=dist/_worker.js",
    "typecheck": "npm --prefix workers/api run typecheck",
    "test": "tsx --test workers/api/tests/*.test.ts",
    "test:integration": "node workers/api/tests/integration.mjs",
    "test:browser": "playwright test apps/web/tests/workspace.spec.js --workers=1 --reporter=line",
    "test:fixtures": "wrangler d1 execute ai-workspace-local --local --config wrangler.local.jsonc --file database/test-fixtures.sql",
    "db:migrate:local": "wrangler d1 migrations apply ai-workspace-local --local --config wrangler.local.jsonc",
    "security:scan": "node scripts/check-secrets.mjs",
    "owner:create": "node scripts/create-owner.mjs",
    "preview": "vite preview",
    "dev:web": "vite --host 0.0.0.0",
    "dev:api": "npm --prefix workers/api run dev"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "wrangler": "^4.149.0"
  }
}
