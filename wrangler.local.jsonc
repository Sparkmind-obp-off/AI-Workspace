{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ai-workspace-local",
  "pages_build_output_dir": "./dist",
  "compatibility_date": "2025-09-27",
  "vars": { "ALLOWED_ORIGIN": "http://localhost:3000", "APIFY_ACTORS": "[]", "SESSION_VERSION": "1" },
  "d1_databases": [{ "binding": "DB", "database_name": "ai-workspace-local", "database_id": "00000000-0000-0000-0000-000000000001", "migrations_dir": "database/migrations" }]
}
